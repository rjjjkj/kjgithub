import os
import json
import psutil
import subprocess
import urllib.request
from fastapi import FastAPI, Form
from fastapi.responses import HTMLResponse, RedirectResponse
from websocket import create_connection

app = FastAPI()

MODE_FILE = "/etc/camilladsp/current_mode"
SYS_AUDIT_FILE = "/opt/api-server/latest_audit.txt"
AUDIO_AUDIT_FILE = "/opt/api-server/latest_audio_audit.txt"
CAMILLADSP_WS = "ws://127.0.0.1:1234"
OLLAMA_API_URL = "http://127.0.0.1:11434/api/generate"
OLLAMA_MODEL = "qwen2.5:0.5b"

def query_ollama(prompt: str, max_tokens: int = 200, timeout: float = 35.0) -> str:
    payload = {
        "model": OLLAMA_MODEL,
        "prompt": prompt,
        "stream": False,
        "keep_alive": "24h",
        "options": {
            "num_predict": max_tokens,
            "temperature": 0.2,
            "repeat_penalty": 1.15,
            "num_ctx": 1024
        }
    }
    req = urllib.request.Request(
        OLLAMA_API_URL,
        data=json.dumps(payload).encode("utf-8"),
        headers={"Content-Type": "application/json"}
    )
    with urllib.request.urlopen(req, timeout=timeout) as res:
        data = json.loads(res.read().decode("utf-8"))
        return data.get("response", "").strip()

def get_sys_info():
    mode = "unknown"
    if os.path.exists(MODE_FILE):
        try:
            with open(MODE_FILE, "r") as f:
                mode = f.read().strip()
        except Exception:
            pass

    track = "停止中 / 不明"
    try:
        out = subprocess.check_output(
            ["journalctl", "-u", "raspotify", "-n", "15", "--output=cat"],
            stderr=subprocess.DEVNULL, text=True
        )
        tracks = [l for l in out.splitlines() if "Loading <" in l]
        if tracks:
            track = tracks[-1].strip()
    except Exception:
        pass

    return {
        "cpu": psutil.cpu_percent(interval=None),
        "mem": psutil.virtual_memory().percent,
        "mem_used": round(psutil.virtual_memory().used / 1024 / 1024, 1),
        "mem_total": round(psutil.virtual_memory().total / 1024 / 1024, 1),
        "disk": psutil.disk_usage("/").percent,
        "load": os.getloadavg(),
        "mode": mode,
        "track": track
    }

def get_camilladsp_telemetry():
    try:
        ws = create_connection(CAMILLADSP_WS, timeout=2)
        ws.send('"GetPlaybackSignalLevels"')
        playback_levels = json.loads(ws.recv()).get("value", {})
        ws.send('"GetCaptureSignalLevels"')
        capture_levels = json.loads(ws.recv()).get("value", {})
        ws.send('"GetClippedSamples"')
        clipped = json.loads(ws.recv()).get("value", 0)
        ws.send('"GetVolume"')
        volume = json.loads(ws.recv()).get("value", 0)
        ws.close()
        return {
            "volume_db": volume,
            "clipped_samples": clipped,
            "playback_rms": playback_levels.get("rms", []),
            "playback_peak": playback_levels.get("peak", []),
            "capture_rms": capture_levels.get("rms", []),
            "capture_peak": capture_levels.get("peak", [])
        }
    except Exception as e:
        return {"error": str(e)}

@app.get("/metrics")
def metrics():
    info = get_sys_info()
    dsp = get_camilladsp_telemetry()
    return {
        "system": {
            "cpu_percent": info["cpu"],
            "memory_percent": info["mem"],
            "memory_used_mb": info["mem_used"],
            "memory_total_mb": info["mem_total"],
            "disk_percent": info["disk"],
            "load_avg": info["load"]
        },
        "audio": {
            "dsp_mode": info["mode"],
            "sample_rate": 96000,
            "dac": "Fostex HP-A3",
            "last_track": info["track"],
            "dsp_telemetry": dsp
        }
    }

