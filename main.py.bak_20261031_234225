@app.post("/set-mode")
def set_mode(mode: str = Form(...)):
    if mode in ["speaker", "iem"]:
        subprocess.run(["sudo", "/usr/local/bin/dsp-mode", mode], check=False)
    return RedirectResponse(url="/", status_code=303)

@app.post("/run-audio-audit")
def run_audio_audit():
    telemetry = get_camilladsp_telemetry()
    info = get_sys_info()
    payload_str = json.dumps({
        "mode": info["mode"],
        "track": info["track"],
        "dsp": telemetry
    }, ensure_ascii=False)

    prompt = f"""CamillaDSPテレメトリを3点で簡潔に評価せよ(前置き不要):
データ: {payload_str}
1. クリッピング余裕度(Preamp -6.5dB基準)
2. ダイナミクス状態
3. {info['mode']}環境(SC-M37またはradius Noir)への一言アドバイス"""

    try:
        report = query_ollama(prompt, max_tokens=180, timeout=35.0)
    except Exception as e:
        report = f"音響診断失敗: {e}"

    with open(AUDIO_AUDIT_FILE, "w", encoding="utf-8") as f:
        f.write(report)
    return RedirectResponse(url="/", status_code=303)

@app.post("/run-sys-audit")
def run_sys_audit():
    info = get_sys_info()
    payload_str = json.dumps(info, ensure_ascii=False)

    prompt = f"""k2-serverのメトリクスを簡潔に評価せよ(前置き不要):
データ: {payload_str}
CPU・メモリ・ディスク数値から異常有無とリソース余裕度を3行以内で記述すること。"""

    try:
        report = query_ollama(prompt, max_tokens=150, timeout=35.0)
    except Exception as e:
        report = f"システム診断失敗: {e}"

    with open(SYS_AUDIT_FILE, "w", encoding="utf-8") as f:
        f.write(report)
    return RedirectResponse(url="/", status_code=303)
