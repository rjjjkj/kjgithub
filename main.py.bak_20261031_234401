@app.get("/set-mode/{mode}")
def set_mode(mode: str):
    if mode == "spk":
        subprocess.run("sudo ln -sf /etc/camilladsp/config_speaker.yml /etc/camilladsp/config.yml && sudo systemctl restart camilladsp.service", shell=True)
    elif mode == "iem":
        subprocess.run("sudo ln -sf /etc/camilladsp/config_iem_rock.yml /etc/camilladsp/config.yml && sudo systemctl restart camilladsp.service", shell=True)
    return {"status": "ok", "mode": mode}

@app.get("/binaural/start")
def start_binaural(background_tasks: BackgroundTasks):
    def _run():
        if not os.path.exists(BINAURAL_FILE):
            subprocess.run("/usr/local/bin/k2-binaural-gen", shell=True)
        subprocess.run("aplay -D loop_shared /run/k2-audio/sleep_delta.wav", shell=True)
    background_tasks.add_task(_run)
    return {"status": "started"}

@app.get("/binaural/stop")
def stop_binaural():
    subprocess.run("pkill -f 'aplay.*sleep_delta'", shell=True)
    return {"status": "stopped"}

@app.get("/ai-analyze")
def ai_analyze():
    dac = get_dac_status()
    mode = get_current_profile()
    prompt = f"""[System: You are an expert audio DSP engineer. Strictly analyze technical acoustic engineering parameters only. Do NOT give medical, anatomical, or biological advice.]
Device: FOSTEX HP-A3 (24bit/96kHz bit-perfect).
Profile: {mode.upper()}.
DAC Status: {dac['status']} ({dac['freq']}).
Task: Evaluate the frequency response, ITD crossfeed separation, and headroom safety. Keep it concise in Japanese (3 bullet points)."""

    try:
        res = requests.post("http://127.0.0.1:11434/api/generate", json={
            "model": "qwen2.5:1.5b",
            "prompt": prompt,
            "stream": False,
            "options": {"temperature": 0.2}
        }, timeout=15)
        return {"analysis": res.json().get("response", "診断結果の取得に失敗しました。")}
    except Exception as e:
        return {"analysis": f"Ollama連携エラー: {str(e)}"}
