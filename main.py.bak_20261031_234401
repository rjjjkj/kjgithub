import subprocess
import os
import re
from fastapi import FastAPI, BackgroundTasks
from fastapi.responses import HTMLResponse
import requests

app = FastAPI(title="k2-server Audio Hub v2")

CONFIG_PATH = "/etc/camilladsp/config.yml"
DAC_STREAM_PATH = "/proc/asound/card3/stream0"
BINAURAL_FILE = "/run/k2-audio/sleep_delta.wav"

def get_dac_status():
    if not os.path.exists(DAC_STREAM_PATH):
        return {"status": "Disconnected", "freq": "N/A", "format": "N/A"}
    try:
        with open(DAC_STREAM_PATH, "r") as f:
            content = f.read()
        status = "Running" if "Status: Running" in content else "Stop"
        freq_match = re.search(r"Momentary freq = (\d+) Hz", content)
        freq = f"{int(freq_match.group(1))//1000}kHz" if freq_match else "96kHz"
        fmt = "24bit" if "S24_3LE" in content else "16bit"
        return {"status": status, "freq": freq, "format": fmt}
    except Exception:
        return {"status": "Error", "freq": "N/A", "format": "N/A"}

def get_current_profile():
    if os.path.islink(CONFIG_PATH):
        target = os.readlink(CONFIG_PATH)
        if "speaker" in target:
            return "speaker"
    return "iem"

@app.get("/", response_class=HTMLResponse)
