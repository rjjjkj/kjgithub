#!/usr/bin/env bash
set -euo pipefail

# ステージングされた変更（追加・変更ファイル）を取得
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM)
if [ -z "$STAGED_FILES" ]; then
    exit 0
fi

echo "🔒 [pre-commit] 機密情報・トークン混入チェックを実行中..."

# 1. 危険なファイル名自体のコミットをブロック
FORBIDDEN_FILES=$(echo "$STAGED_FILES" | grep -iE '(^|/)\.env($|\.)|\.(pem|key|p12|pfx)$|id_(rsa|ed25519)|credentials\.json' || true)
if [ -n "$FORBIDDEN_FILES" ]; then
    echo "❌ [ERROR] 機密ファイルがステージングされています:"
    echo "$FORBIDDEN_FILES"
    echo "💡 対処: 'git reset HEAD <ファイル名>' でステージングを解除し、.gitignore に追加してください。"
    exit 1
fi

# 2. 追加された行（+）からトークン・秘密鍵パターンを検査
# 検出対象: Tailscale AuthKey, GitHub PAT, Google API Key, AWS Key, OpenAI/Anthropic Key, SSH秘密鍵, ハードコードされたパスワード類
SECRET_REGEX='(tskey-auth-[a-zA-Z0-9_-]{10,}|gh[pousr]_[A-Za-z0-9_]{20,}|github_pat_[A-Za-z0-9_]{20,}|AIza[0-9A-Za-z_-]{35}|AKIA[0-9A-Z]{16}|sk-[a-zA-Z0-9]{20,}|-----BEGIN [A-Z ]*PRIVATE KEY-----|(password|passwd|secret|token|authkey|api_key)[[:space:]]*=[[:space:]]*["'\''][A-Za-z0-9_\-\./+=]{12,}["'\''])'

# ダミー文字列（ここにキーを入力、xxxx、example等）は除外して判定
MATCHES=$(git diff --cached -U0 | grep -E '^\+[^+]' | grep -iE "$SECRET_REGEX" | grep -vE '(ここにキーを入力|xxxx|your_token|example|dummy|os\.getenv|userdata\.get)' || true)

if [ -n "$MATCHES" ]; then
    echo "❌ [ERROR] コミット内容にトークンまたは秘密鍵のパターンが検出されました！"
    echo "------------------------------------------------------------"
    echo "$MATCHES"
    echo "------------------------------------------------------------"
    echo "💡 対処: トークンを環境変数 (os.getenv) に置き換えてから再度 git add してください。"
    echo "⚠️ 誤検知で強制コミットする場合は 'git commit --no-verify' を使用してください。"
    exit 1
fi

echo "✅ [pre-commit] 機密情報チェック完了（問題なし）"
exit 0
